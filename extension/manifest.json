{
  "manifest_version": 3,
  "name": "RepoBridge",
  "version": "1.2.0",
  "description": "Connects browser LLM chat to a local Git-safe coding daemon.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["selectors.js", "parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}