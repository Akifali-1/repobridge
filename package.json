{
  "name": "repobridge-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "RepoBridge: local Git-safe daemon and Chrome MV3 extension for browser LLM code interaction",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akifali-1/repobridge.git"
  },
  "bugs": {
    "url": "https://github.com/Akifali-1/repobridge/issues"
  },
  "homepage": "https://github.com/Akifali-1/repobridge#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix daemon run build",
    "typecheck": "npm --prefix daemon run typecheck",
    "lint": "eslint \"daemon/src/**/*.ts\" \"extension/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"daemon/src/**/*.ts\" \"extension/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"daemon/src/**/*.ts\" \"extension/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\"",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^10.15.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.20.0"
  }
}